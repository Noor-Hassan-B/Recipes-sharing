# ==============================================================================
# FlavorCraft Recipe Sharing - Environment Configuration
# NEVER commit .env to version control! Keep all credentials secure.
# ==============================================================================

# Application Port
PORT=5000

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/recipe_sharing_db
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/recipe_sharing_db

# Database Name
DB_NAME=recipe_sharing_db

# JWT Security Secrets (CRITICAL: Change to a 64+ char random string in production)
# Example generation: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_64_character_secret_key_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated for multiple origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
