# MongoDB Connection String (e.g. mongodb://127.0.0.1:27017/recipe_sharing_db or Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/recipe_sharing_db

# Database Name
DB_NAME=recipe_sharing_db

# Environment
NODE_ENV=development

# JWT Secret
JWT_SECRET=replace_with_a_secure_random_64_character_secret_key_in_production
JWT_EXPIRES_IN=7d
